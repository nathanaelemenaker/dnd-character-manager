# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# PostgreSQL connection string — matches the db service in docker-compose.yml
DATABASE_URL="postgresql://app:app@db:5432/app?schema=public"

# The public URL of your app (no trailing slash)
APP_BASE_URL="https://yourdomain.com"

# Random secret used to sign session cookies — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="replace-with-random-64-char-hex-string"

# Comma-separated list of Prisma user IDs that get SUPER_ADMIN role
# Find your ID after first login via: SELECT id, email FROM "User";
ADMIN_USER_IDS="your-cuid-here"

# Optional: any user with an email ending in this domain gets ADMIN role
# Leave blank to disable domain-based admin access
ADMIN_EMAIL_DOMAIN=""

# Anthropic API key — used for the Session Log Generator feature
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# WhisperX diarization service — self-hosted FastAPI wrapper (built from ./whisperx)
# Default works with docker-compose (service name = whisper, port = 8000)
WHISPER_API_URL="http://whisper:8000"

# HuggingFace token — required for the pyannote speaker-diarization model (gated).
# 1. Create a read token at https://huggingface.co/settings/tokens
# 2. Accept the license at https://huggingface.co/pyannote/speaker-diarization-3.1
# 3. Accept the license at https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN="hf_..."

# WhisperX transcription model. Tradeoff: accuracy vs. CPU time.
# small  = good quality, tolerable speed on CPU (default)
# medium = better accuracy, noticeably slower
# (Set via WHISPERX_MODEL env in docker-compose, not this app env var)

# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# PostgreSQL connection string — matches the db service in docker-compose.yml
DATABASE_URL="postgresql://app:app@db:5432/app?schema=public"

# The public URL of your app (no trailing slash)
APP_BASE_URL="https://yourdomain.com"

# Random secret used to sign session cookies — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="replace-with-random-64-char-hex-string"

# Comma-separated list of Prisma user IDs that get SUPER_ADMIN role
# Find your ID after first login via: SELECT id, email FROM "User";
ADMIN_USER_IDS="your-cuid-here"

# Optional: any user with an email ending in this domain gets ADMIN role
# Leave blank to disable domain-based admin access
ADMIN_EMAIL_DOMAIN=""

# Anthropic API key — used for the Session Log Generator feature
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

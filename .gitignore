# Dependencies
node_modules/

# Build output
.next/

# Environment variables — NEVER commit these
.env
.env.local
.env.production

# Database
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db

# Synology NAS metadata — never commit these
@eaDir/
**/@eaDir/
*.@SynoEAStream
**/*.@SynoEAStream

# Logs
*.log
npm-debug.log*

# Prisma generated client (regenerated on deploy)
prisma/generated/

# User-uploaded files — persisted on the host filesystem, not in git
public/uploads/
dnd_backup.sql
